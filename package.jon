{
  "name": "palm-rejection-overlay",
  "version": "1.0.0",
  "description": "Fullscreen transparent palm rejection overlay app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron": "^30.0.0"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.overlay.palmrejection",
    "productName": "Palm Rejection Overlay",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "files": [
      "**/*"
    ]
  }
}